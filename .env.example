# Copy to .env and adjust, then: docker compose up asr
#
# ASR_ASSETS_DIR is the HOST directory that gets mounted at /data/asr inside the
# container. Every other path below must be the IN-CONTAINER path.

ASR_ASSETS_DIR=/data/asr

# --- required -------------------------------------------------------------
ASR_MODEL_PATH=/data/asr/ams/Conformer-CTC-BPE-v1_95_400-averaged.onnx

# --- language model (optional) --------------------------------------------
# Without these the service falls back to an LM-free beam search and says so in
# /health. Requires the gpu-kenlm build target.
ASR_LM_PATH=/data/asr/lms/12.0/merged_lm.bin
ASR_LEXICON_PATH=/data/asr/lms/12.0/merged_lm.lexicon

# One token per line, blank symbol last. Omit to use the built-in reference
# vocabulary.
# ASR_VOCAB_PATH=/data/asr/vocabulary.txt

# --- window geometry ------------------------------------------------------
# The reference operating point. Not known to be optimal -- sweep it with
# streaming_asr.benchmark before settling.
ASR_CHUNK_MS=160
ASR_CONTEXT_SEC=3.84

# --- stabilisation --------------------------------------------------------
# stability_window dominates perceived latency and MUST stay below
# ASR_CONTEXT_SEC, or words scroll out of the buffer before they can commit.
ASR_STABILITY_WINDOW=0.6
ASR_MIN_STABLE_UPDATES=2
# Set to 'levenshtein' if tools/check_alignment_fidelity.py reports that the
# model's timestamps track the window rather than the audio.
ASR_ALIGNER=time

# --- execution ------------------------------------------------------------
# 'auto', 'cpu', 'cuda' or 'cuda:N'. /health reports what actually loaded,
# which is not always what was asked for -- check it before believing a
# benchmark.
ASR_DEVICE=auto

# ONNX Runtime intra-op threads. 0 = every core, which is the library default
# and the WRONG choice for a CPU deployment serving more than one stream: each
# inference claims the whole machine and concurrent streams fight. Measured on
# 4 physical cores, response p50 at 4 concurrent streams: 6133 ms at 0, against
# 3412 ms pinned to 2. Roughly 2 physical cores per stream is a sane starting
# point. Ignored on CUDA.
# ASR_INTRA_OP_THREADS=2

# --- capacity -------------------------------------------------------------
# The single most dangerous number in this file. Measured on a 4 GB GTX 1650
# with the real checkpoint: a 16-caller burst against a cap of 32 exhausted GPU
# memory and killed the service (0 of 16 served); the same burst against a cap
# of 4 served four callers at 1.1 s p95 and refused twelve cleanly.
#
# Derive it from a sweep on YOUR hardware, do not copy this value:
#   python -m tests.load.run_load_sweep --audio sample.wav --levels 1,2,4,8,16
# See tests/load/README.md.
ASR_MAX_CONCURRENT_STREAMS=4

ASR_PORT=8000
ASR_LOG_LEVEL=info
